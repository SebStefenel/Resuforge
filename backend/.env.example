# Copy to .env for local dev. On Fly.io these are set as secrets instead:
#   fly secrets set SUPABASE_URL=... SUPABASE_ANON_KEY=... ALLOWED_ORIGINS=...

# Used to validate the caller's Supabase session token on /api/compile*.
# Same two values the frontend uses (Supabase Dashboard → Settings → API).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated origins allowed to call this backend. Leave unset locally
# to allow all origins; set to the Vercel URL in production, e.g.
# https://resuforge.vercel.app
ALLOWED_ORIGINS=
